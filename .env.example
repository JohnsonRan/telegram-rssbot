# Telegram Bot Token (从 @BotFather 获取)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 白名单用户ID (逗号分隔，用于私聊权限控制)
# 获取方式：向 @userinfobot 发消息查看你的ID
WHITE_LIST=123456789,987654321

# GitHub Token (可选) — 仅在 Release 无自动 Changelog 时触发 API fallback
# 未配置：60次/小时；配置后：5000次/小时
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# /sticker 转换配置：静态贴纸/图片输出 PNG，动态贴纸/视频贴纸输出 GIF
TG2GIF_MAX_SIZE=240
# 最高输出帧率；实际帧率会按源文件帧率、时长和体积限制自适应降低
TG2GIF_FPS=30
TG2GIF_MAX_BYTES=1000000
# 微信导入透明文件可能显示黑底，默认铺白底；需要透明可改为 transparent
TG2GIF_BACKGROUND=white
